---
layout: base.njk
---
<article>
  <header>
    <h1>{{ title }}</h1>
    <p class="story-date"><time datetime="{{ date | isoDate }}">{{ date | ruDate }}</time></p>
  </header>
  {% if illustrationFiles.length %}
  <div class="story-illustrations">
    {% for file in illustrationFiles %}
    <figure><a href="{{ file }}" target="_blank"><img src="{{ file }}" alt="" loading="lazy"></a></figure>
    {% endfor %}
  </div>
  {% endif %}
  {{ content | safe }}
  {# Ссылка выглядит как обычный адрес страницы, но ведёт на t.me/share
     с адресом её Instant View-версии: шаблон IV не в общем пуле, поэтому
     нужна ссылка t.me/iv с rhash шаблона (site.json). Кодируется дважды:
     адрес внутри iv-ссылки и вся iv-ссылка внутри share. #}
  {% set pageUrl = site.url + (page.url | url) %}
  {% set ivUrl = "https://t.me/iv?url=" + (pageUrl | urlencode) + "&rhash=" + site.ivRhash %}
  <footer class="story-share">
    <a href="https://t.me/share/url?url={{ ivUrl | urlencode }}" data-copy-title="{{ title }}" target="_blank" rel="noopener">{{ pageUrl }}</a>
    <span class="story-share-status" aria-live="polite"></span>
  </footer>
</article>
