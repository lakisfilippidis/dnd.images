---
layout: base.njk
---
<article>
  <header>
    <h1>{{ title }}</h1>
    <p class="story-date"><time datetime="{{ date | isoDate }}">{{ date | ruDate }}</time></p>
  </header>
  {% if illustrationFiles.length %}
  <div class="story-illustrations">
    {% for file in illustrationFiles %}
    <figure><a href="{{ file }}" target="_blank"><img src="{{ file }}" alt="" loading="lazy"></a></figure>
    {% endfor %}
  </div>
  {% endif %}
  {{ content | safe }}
  {# Ссылка ведёт на t.me/share с адресом Instant View-версии страницы:
     шаблон IV не в общем пуле, поэтому нужна ссылка t.me/iv с rhash шаблона
     (site.json). Кодируется дважды: адрес внутри iv-ссылки и вся iv-ссылка
     внутри share. #}
  {% set pageUrl = site.url + (page.url | url) %}
  {% set ivUrl = "https://t.me/iv?url=" + (pageUrl | urlencode) + "&rhash=" + site.ivRhash %}
  <footer class="story-share">
    <a href="https://t.me/share/url?url={{ ivUrl | urlencode }}" target="_blank" rel="noopener">Поделиться в тг</a>
  </footer>
</article>
