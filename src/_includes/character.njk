---
layout: base.njk
bodyClass: character-page
breadcrumbSection: Персонажи
breadcrumbSectionUrl: /Characters/
---
<div class="container">
  <div class="sidebar">
    {% if portrait %}
    <img class="portrait" eleventy:widths="800,1200" sizes="(orientation: portrait) 98vw, 30vw" src="{{ portrait }}" alt="Портрет">
    {% endif %}
    {% include "stat-block.njk" %}
    {% include "combat-block.njk" %}
    {% include "add-to-battle.njk" %}
  </div>
  <div class="content">
    {{ content | safe }}
  </div>
</div>
