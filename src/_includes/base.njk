<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    {# Превью ссылок в мессенджерах. URL абсолютные: домен в src/_data/site.json,
       ogImage / ogDescription вычисляются в eleventy.config.js #}
    {% if ogDescription %}<meta name="description" content="{{ ogDescription }}">{% endif %}
    <link rel="canonical" href="{{ site.url }}{{ page.url | url }}">
    <meta property="og:site_name" content="{{ site.name }}">
    <meta property="og:locale" content="ru_RU">
    <meta property="og:type" content="{{ 'article' if tags == 'story' else 'website' }}">
    <meta property="og:title" content="{{ title }}">
    <meta property="og:url" content="{{ site.url }}{{ page.url | url }}">
    {% if ogDescription %}<meta property="og:description" content="{{ ogDescription }}">{% endif %}
    {% if ogImage %}
    <meta property="og:image" content="{{ site.url }}{{ (page.url + ogImage) | url }}">
    <meta name="twitter:card" content="summary_large_image">
    {% else %}
    <meta name="twitter:card" content="summary">
    {% endif %}
    {% if tags == 'story' and date %}<meta property="article:published_time" content="{{ date | isoDate }}">{% endif %}
    <link href="https://fonts.googleapis.com/css2?family=Neucha&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ '/styles/shared.css' | url }}">
    {# battle-config.js грузит док dice-roller и по наличию элементов — add-to-battle / roll-dice #}
    <script type="module" src="{{ '/scripts/battle-config.js' | url }}"></script>
    <script type="module" src="{{ '/scripts/tg-login.js' | url }}"></script>
    {% if tags == 'story' %}
    <script type="module" src="{{ '/scripts/share-copy.js' | url }}"></script>
    {% endif %}
    {% if bodyClass == "map-page" %}
    <script type="module" src="{{ '/scripts/map-canvas.js' | url }}"></script>
    {% endif %}
    {% if typeFilter %}
    <script type="module" src="{{ '/scripts/type-filter.js' | url }}"></script>
    {% endif %}
    {% if bodyClass == "home-page" %}
    <script type="module" src="{{ '/scripts/grid-lanes-fallback.js' | url }}"></script>
    {% endif %}
    {% if alchemyLab %}
    <script type="module" src="{{ '/scripts/alchemy-lab.js' | url }}"></script>
    {% endif %}
    {# featFilter — фильтр карточек черт и снаряжения (featList, weaponList, armorList) #}
    {% if featFilter %}
    <script type="module" src="{{ '/scripts/feat-filter.js' | url }}"></script>
    {% endif %}
    {% if scaleTracker %}
    <script type="module" src="{{ '/scripts/scale-tracker.js' | url }}"></script>
    {% endif %}
  </head>
  <body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
    <nav class="top-menu">
      <a href="{{ '/' | url }}">Главная</a>
      <a href="{{ '/Characters/' | url }}">Персонажи</a>
      <a href="{{ '/Personalities/' | url }}">Личности</a>
      <a href="{{ '/Races/' | url }}">Расы</a>
      <a href="{{ '/Classes/' | url }}">Классы</a>
      <a href="{{ '/Feats/' | url }}">Черты</a>
      <a href="{{ '/Equipment/' | url }}">Снаряжение</a>
      <a href="{{ '/Creatures/' | url }}">Существа</a>
      <a href="{{ '/Maps/' | url }}">Карты</a>
      <a href="{{ '/Stories/' | url }}">Истории</a>
      <a href="{{ '/Glossary/' | url }}">Глоссарий</a>
      <a href="{{ '/Rules/' | url }}">Правила</a>
      <tg-login bot-id="8995479777"></tg-login>
    </nav>
    <div class="content-wrapper">
      {% if breadcrumbSection %}
      <nav class="breadcrumbs">
        <a href="{{ '/' | url }}">Главная</a> &gt;
        {% if eleventyExcludeFromCollections %}
          <span>{{ breadcrumbSection }}</span>
        {% else %}
          <a href="{{ breadcrumbSectionUrl | url }}">{{ breadcrumbSection }}</a> &gt;
          <span>{{ title }}</span>
        {% endif %}
      </nav>
      {% endif %}
      {{ content | safe }}
    </div>
    <nav id="page-toc"></nav>
    <battle-toolbar
      label-map="Боевое поле"
      label-pool="Пул токенов"
      label-dice="Бросить кубики"
      label-title="Инициатива"
      label-round="Раунд"
      label-next="Следующий ход"
      label-fill="Дозаполнить"
      label-reset="Сброс"
      label-resetconfirm="Убрать всех бойцов и завершить бой?"
      label-empty="Нет бойцов в бою"
      label-name="Имя"
      label-hp="ХП"
      label-ac="КБ"
      label-init="Ин."
      label-remove="Убрать из боя"
      label-link="Открыть страницу"
      label-sync="Совместная игра"
      label-synccreate="Создать комнату из этого боя"
      label-syncjoin="Войти"
      label-syncleave="Отключиться"
      label-synccodeplaceholder="код-комнаты"
      label-syncoff="Не подключено"
      label-syncconnecting="Подключение к"
      label-syncconnected="Комната"
      label-syncunknownroom="Нет такой комнаты"
      label-syncfailed="Ошибка синхронизации"
      label-syncjoinconfirm="Вход в комнату заменит текущий бой состоянием комнаты. Продолжить?"
      label-synccopylink="Скопировать ссылку-приглашение"
      label-synccopied="Ссылка скопирована"
      label-syncname="Ваше имя"
      label-synccolor="Ваш цвет"
      label-syncplayer="игрок"
      label-syncclose="Закрыть"
      label-syncroomsection="Комната"
      label-syncplayers="В комнате"
      label-syncnobody="Никто не подключён"
      label-syncyou="вы"
      label-syncprofilesection="Вы"
      label-syncjoinsection="Войти или создать"
      label-syncrooms="Комнаты на сервере"
      label-syncrefresh="Обновить"
      label-syncupdated="Обновлено"
      label-syncconnections="подключений"
      label-synccurrent="текущая"
      label-syncnorooms="Комнат пока нет"
      label-syncroomsfailed="Не удалось загрузить список комнат"
      label-syncoutdated="Страница устарела — перезагрузите её, чтобы синхронизироваться"
      label-image="Картинка"
      label-lock="Закрепить"
      label-unlock="Открепить"
      label-imageremove="Удалить картинку"></battle-toolbar>
    <script>
      (function() {
        var body = document.body;
        var toc = document.getElementById('page-toc');
        if (body.classList.contains('list-page') || body.classList.contains('home-page')) {
          toc.style.display = 'none';
          return;
        }
        var headers = document.querySelectorAll('h2, h3');
        if (!headers.length) {
          toc.style.display = 'none';
          return;
        }
        headers.forEach(function(h) {
          if (!h.id) {
            h.id = h.textContent.trim().toLowerCase().replace(/\s+/g, '-').replace(/[^\w\u0400-\u04ff-]/g, '');
          }
          var a = document.createElement('a');
          a.href = '#' + h.id;
          a.textContent = h.textContent;
          if (h.tagName === 'H3') {
            a.classList.add('toc-h3');
          }
          toc.appendChild(a);
        });
      })();
    </script>
  </body>
</html>
