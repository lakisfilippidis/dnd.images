---
layout: base.njk
title: "Мир DnD — Главная"
bodyClass: "home-page"
needsFont: true
typeFilter: true
sections:
  - title: "Карты"
    url: "/Maps/"
    tag: "maps"
    mapPreview: true
  - title: "Расы"
    url: "/Races/"
    tag: "races"
    withPreview: true
  - title: "Классы"
    url: "/Classes/"
    tag: "classes"
  - title: "Персонажи"
    url: "/Characters/"
    tag: "characters"
    withPreview: true
  - title: "Личности"
    url: "/Personalities/"
    tag: "personalities"
    withPreview: true
  - title: "Существа"
    url: "/Creatures/"
    tag: "creatures"
    withPreview: true
    typeFilter: true
---
<header>
  <h1>Мир DnD</h1>
  <p>Выберите раздел или страницу для просмотра</p>
</header>

<div class="home-sections">
  {% for section in sections %}
  <section class="home-section{% if section.withPreview %} home-section--previews{% endif %}{% if section.mapPreview %} home-section--maps{% endif %}">
    <h2><a href="{{ section.url | url }}">{{ section.title }}</a></h2>
    {% if section.typeFilter %}
    {% include "type-filter.njk" %}
    {% endif %}
    <div class="home-section-list">
      {% set withPreview = section.withPreview %}
      {% set mapPreview = section.mapPreview %}
      {% for item in collections[section.tag] %}
        {% include "section-item.njk" %}
      {% endfor %}
    </div>
  </section>
  {% endfor %}
  <section class="home-section">
    <h2>Справочник</h2>
    <div class="home-section-list">
      <a class="home-section-item" href="{{ '/Glossary/' | url }}">
        <span class="home-section-item-title">Глоссарий</span>
      </a>
      <a class="home-section-item" href="{{ '/Rules/' | url }}">
        <span class="home-section-item-title">Правила</span>
      </a>
    </div>
  </section>
</div>

<footer>
  &copy; 2025 — Мир DnD Darzalas
</footer>
